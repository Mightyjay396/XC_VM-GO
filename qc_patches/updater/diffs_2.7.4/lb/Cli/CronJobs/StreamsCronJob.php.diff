+	/**
+	 * QC-GO-OD-STATS: on-demand channels served by the Go relay (odrelay) have no ffmpeg pid,
+	 * so XC_VM never fills their stats. Copy what odrelay measures (codecs, size, fps, bitrate)
+	 * plus its CPU/RAM share into the stream row, like a running producer's report.
+	 */
+	private function qcGoOnDemandStats($db): void {
+		$rRaw = @file_get_contents('http://127.0.0.1:8147/stats', false, stream_context_create(['http' => ['timeout' => 3]]));
+		$rHubs = $rRaw === false ? null : json_decode($rRaw, true);
+		if (!is_array($rHubs)) {
+			return;
+		}
+		$rStateFile = '/home/xc_vm/tmp/qc_go_od_stats.json';
+		$rPrev = json_decode((string) @file_get_contents($rStateFile), true) ?: [];
+		$rLive = [];
+		$rTotal = 0;
+		foreach ($rHubs as $rID => $rHub) {
+			if (ctype_digit((string) $rID) && !empty($rHub['started']) && !empty($rHub['info']['kbps']) && ($rHub['viewers'] > 0 || $rHub['idle_s'] < 60)) {
+				$rLive[$rID] = $rHub;
+				$rTotal += $rHub['info']['kbps'];
+			}
+		}
+		$rCPU = null;
+		$rMem = null;
+		$rPid = intval(trim((string) @shell_exec('pidof -s odrelay')));
+		$rSample = $rPid > 0 ? ProcessManager::resourceSample($rPid) : null;
+		if ($rSample !== null) {
+			$rMem = $rSample['rss'];
+			if (isset($rPrev['sample']) && intval($rPrev['pid'] ?? 0) === $rPid) {
+				$rCPU = ProcessManager::cpuPercent($rSample, $rPrev['sample']);
+			}
+		}
+		foreach ($rLive as $rID => $rHub) {
+			$rI = $rHub['info'];
+			$rShare = $rTotal > 0 ? $rI['kbps'] / $rTotal : 0;
+			$rVideo = ['codec_name' => $rI['video'] ?: 'N/A'];
+			if (!empty($rI['width'])) {
+				$rVideo['width'] = $rI['width'];
+				$rVideo['height'] = $rI['height'];
+			}
+			if (!empty($rI['fps'])) {
+				$rVideo['r_frame_rate'] = $rI['fps'];
+			}
+			$rStreamInfo = ['codecs' => ['video' => $rVideo, 'audio' => ['codec_name' => $rI['audio'] ?: 'N/A']], 'container' => 'mpegts'];
+			$rProgress = ['fps' => $rI['fps'] ?? null, 'speed' => '1x', 'bitrate' => $rI['kbps'] . 'kbits/s', 'producer' => 'go', 'go_at' => time(), 'cpu' => $rCPU === null ? null : round($rCPU * $rShare, 1), 'mem' => $rMem === null ? null : (int) ($rMem * $rShare)];
+			$rFields = ['stream_info' => json_encode($rStreamInfo), 'progress_info' => json_encode($rProgress), 'bitrate' => intval($rI['kbps']), 'video_codec' => $rI['video'] ?: null, 'audio_codec' => $rI['audio'] ?: null];
+			if (empty($rPrev['ids'][$rID])) {
+				$rFields['stream_started'] = time() - intval($rHub['age_s']);
+			}
+			StreamStateWriter::update(intval($rID), intval(SERVER_ID), $rFields, $db);
+		}
+		foreach (array_diff_key($rPrev['ids'] ?? [], $rLive) as $rID => $rOne) {
+			StreamStateWriter::update(intval($rID), intval(SERVER_ID), ['progress_info' => json_encode([])], $db);
+		}
+		@file_put_contents($rStateFile, json_encode(['ids' => array_fill_keys(array_keys($rLive), 1), 'pid' => $rPid, 'sample' => $rSample]));
+	}
 }
