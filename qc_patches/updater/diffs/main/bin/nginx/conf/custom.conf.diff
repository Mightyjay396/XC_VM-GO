--- a/bin/nginx/conf/custom.conf
+++ b/bin/nginx/conf/custom.conf
@@ -0,0 +1,21 @@
+# Trial API endpoint
+location = /trial_api {
+    fastcgi_pass php;
+    include fastcgi_params;
+    fastcgi_param SCRIPT_FILENAME /home/xc_vm/Public/trial_api.php;
+}
+
+# Line API endpoint (paid lines)
+location = /line_api {
+    fastcgi_pass php;
+    include fastcgi_params;
+    fastcgi_param SCRIPT_FILENAME /home/xc_vm/Public/line_api.php;
+}
+
+# API compatible XAccel  -> Public/xaccel_compat_api.php
+location ^~ /xaapi/ {
+    fastcgi_pass php;
+    include fastcgi_params;
+    fastcgi_param SCRIPT_FILENAME /home/xc_vm/Public/xaccel_compat_api.php;
+    fastcgi_param PATH_INFO $uri;
+}
