+		fclose($rSock);
+		$rStatic = 'http://127.0.0.1:8098/mpd?s=1&d=60&u=' . rawurlencode($rURL) . ($rProxy !== '' ? '&p=' . rawurlencode(self::proxyURL($rProxy)) : '');
+		self::$drmOptions[$rStatic] = self::$drmOptions[$rURL] ?? '';
+		return $rStatic;
+	}
