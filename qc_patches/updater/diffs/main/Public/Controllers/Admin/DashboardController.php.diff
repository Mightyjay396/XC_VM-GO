+	/**
+	 * QC-GO-DELIVERY : serveurs dont la delivery Go QC (odrelay / livehold / ckts, pas fanout) écoute,
+	 * d'après le watchdog de la dernière minute.
+	 *
+	 * @param array<int,array<string,mixed>> $servers
+	 * @return array{state:string,icon:string,title:string,detail:string,help:string,key:string}
+	 */
+	public static function qcGoCheck(array $servers, int $now): array {
+		$rOn = [];
+		$rTotal = 0;
+		foreach ($servers as $srv) {
+			if (empty($srv['enabled']) || $now - intval($srv['last_check_ago'] ?? 0) >= 60) {
+				continue;
+			}
+			$rTotal++;
+			$wd = json_decode($srv['watchdog_data'] ?? '{}', true) ?: [];
+			if (!empty($wd['qc_go'])) {
+				$rOn[] = (string) $srv['server_name'];
+			}
+		}
+		$rDetail = $rOn === [] ? 'Not running on any server' : 'Running on ' . count($rOn) . '/' . $rTotal . ' servers: ' . implode(', ', $rOn);
+		return ['state' => $rOn === [] ? 'off' : 'ok', 'icon' => 'tabler-bolt', 'title' => 'Go delivery (odrelay / livehold / ckts)', 'detail' => $rDetail, 'help' => '', 'key' => 'qc_go'];
+	}
+
