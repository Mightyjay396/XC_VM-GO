+	// od_v2: one supervised stream's state (GET /monitor/<id>), null when unknown.
+	public static function monitorState(int $rStreamID): ?array {
+		$rRes = self::request('GET', '/monitor/' . $rStreamID, null, 1, 2);
+		if ($rRes['errno'] !== 0 || $rRes['code'] !== 200 || !is_string($rRes['body'])) {
+			return null;
+		}
+		$rData = json_decode($rRes['body'], true);
+		return is_array($rData) ? $rData : null;
+	}
