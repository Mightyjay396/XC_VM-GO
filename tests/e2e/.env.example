# Copy to .env (or export in your shell) and fill in for `make e2e`.
# Admin panel base URL INCLUDING the access code (the path segment before /login):
XC_E2E_BASE_URL=http://panel.example.com/ACCESS_CODE
XC_E2E_USER=your_admin_username
XC_E2E_PASS=your_admin_password

# Optional (tests/admin/streams.spec.ts): a LIVE source the panel's server can
# reach, and the server to run the test stream on.
# XC_E2E_STREAM_SOURCE=https://demo.unified-streaming.com/k8s/live/stable/scte35.isml/.m3u8
# XC_E2E_SERVER=Main Server
