<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" defaultTestSuite="XC_VM Unit" bootstrap="bootstrap.php" cacheDirectory=".cache/phpunit" colors="true" failOnRisky="true" failOnWarning="true">
  <testsuites>
    <testsuite name="XC_VM Unit">
      <directory>Unit</directory>
    </testsuite>
  </testsuites>
  <!-- The suite deliberately handles megabyte values (LogImportCronJobsTest's
       oversized spool rows, the crypto vectors, the replica fixtures) and the
       classes that reach them already sit near PHP's 128M default: a run that
       crossed it died with a bare exit 255, the message swallowed by PHPUnit's
       per-test output buffer. -->
  <php>
    <ini name="memory_limit" value="512M"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">../src/Core</directory>
      <directory suffix=".php">../src/Domain</directory>
      <directory suffix=".php">../src/Infrastructure</directory>
      <directory suffix=".php">../src/Modules</directory>
      <directory suffix=".php">../src/Streaming</directory>
      <directory suffix=".php">../src/Cli</directory>
      <file>../src/autoload.php</file>
      <file>../src/bootstrap.php</file>
    </include>
    <exclude>
      <directory suffix=".php">../src/Public/Views</directory>
      <directory suffix=".php">../src/config</directory>
      <directory suffix=".php">../src/ministra</directory>
      <directory suffix=".php">../src/content</directory>
    </exclude>
  </source>
</phpunit>
